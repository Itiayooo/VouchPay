# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/vouchpay

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=myeassescrowasaservicecsc448
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=myeassescrowasaservicecsc448refresh
JWT_REFRESH_EXPIRES_IN=30d

# ─── Paystack ─────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=mypaystackeassescrowasaservicecsc448
PAYSTACK_PUBLIC_KEY=mypaystackpubliceassescrowasaservicecsc448
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# ─── Platform Config ──────────────────────────────────────────────────────────
PLATFORM_FEE_PERCENT=1.5
PLATFORM_FEE_MIN_KOBO=15000
ESCROW_EXPIRY_DAYS=7
QR_EXPIRY_HOURS=168

# ─── WhatsApp / Notifications (optional - Twilio or Africa's Talking) ─────────
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── App URL ──────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:5000
FRONTEND_BASE_URL=http://localhost:5173
